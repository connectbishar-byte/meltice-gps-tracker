[Unit]
Description=Meltice GPS Tracker - Teltonika TCP receiver (port 5027)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=fleet
Group=fleet
WorkingDirectory=/srv/meltice-gps-tracker/app
EnvironmentFile=/etc/meltice-gps-tracker/fleet.env
Environment=FLEET_PROCESS=receiver
ExecStart=/srv/meltice-gps-tracker/venv/bin/python manage.py run_receiver --host 0.0.0.0 --port 5027
Restart=always
RestartSec=5
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/meltice-gps-tracker /var/lib/meltice-gps-tracker /var/log/meltice-gps-tracker
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
